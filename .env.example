# Copy to .env. Never commit .env.

# Use a READ-ONLY Postgres role (see README). Supabase pooler URL works too.
DATABASE_URL=postgresql+psycopg2://ic_readonly:changeme@localhost:5432/postgres
DB_SCHEMA=public

# Any OpenAI-compatible endpoint.
# Ollama: http://localhost:11434/v1   Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b

# Admin/owner connection, ONLY for data_gen/load.py (never the app)
ADMIN_DATABASE_URL=postgresql://postgres:changeme@localhost:5432/postgres

# Optional
SEMANTIC_FILE=semantic.yml
MAX_STEPS=8
MAX_ROWS=1000
STATEMENT_TIMEOUT_MS=15000
API_KEY=

# Output adapters (only fill what you use)
METABASE_URL=
METABASE_API_KEY=
METABASE_DATABASE_ID=
METABASE_COLLECTION_ID=

SUPERSET_URL=
SUPERSET_USER=
SUPERSET_PASSWORD=
SUPERSET_DATABASE_ID=
SUPERSET_SCHEMA=public
