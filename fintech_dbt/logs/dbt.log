-- Grain: one row per payment received (cash-in events).

select
    p.payment_id,
    p.loan_id,
    l.customer_id,
    l.product_id,
    p.installment_no,
    p.paid_at,
    p.paid_at::date                                           as paid_date,
    date_trunc('month', p.paid_at)::date                      as paid_month,
    i.due_date,
