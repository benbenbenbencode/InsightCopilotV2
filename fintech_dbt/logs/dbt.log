    p.amount_paid,
    p.late_fee,
    p.payment_channel
from "postgres"."raw"."raw_payments" p
join "postgres"."raw"."raw_loans" l using (loan_id)
join "postgres"."raw"."raw_installments" i using (loan_id, installment_no)
  );
  
