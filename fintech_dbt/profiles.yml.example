# Copy to ~/.dbt/profiles.yml (or set DBT_PROFILES_DIR to this folder as profiles.yml).
# Use the OWNER connection (Supabase: Session pooler host, port 5432).
fintech_dbt:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('DBT_HOST') }}"
      port: "{{ env_var('DBT_PORT', '5432') | as_number }}"
      user: "{{ env_var('DBT_USER') }}"
      password: "{{ env_var('DBT_PASSWORD') }}"
      dbname: "{{ env_var('DBT_DBNAME', 'postgres') }}"
      schema: public
      threads: 2
      sslmode: "{{ env_var('DBT_SSLMODE', 'require') }}"
      connect_timeout: 30
